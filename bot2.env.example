# Template for a second Codex bot ("bot2").
# Copy to bot2.env, fill in a DISTINCT bot token/username, then:
#     ./start_bot.sh bot2          # start alongside 'main' (kills nothing)
#     ./restart_bot.sh bot2        # restart only this bot
# (bot2.env is gitignored so real tokens never get committed.)

# Required
BOT_ID=bot2
TELEGRAM_BOT_TOKEN=your-second-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_second_bot_username
APPROVED_DIRECTORY=/home/sky/home
ALLOWED_USERS=123456789

# Codex settings (optional; see .env.example for the full list)
# CODEX_MODEL=gpt-5.5
# CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=900

# Session timeout (idle, hours)
SESSION_TIMEOUT_HOURS=24

# DATABASE_URL auto-derives to sqlite:///data/bot_bot2.db (no need to set).
# Inject spool auto-derives to /tmp/codex_inject/bot2/.
# No API/webhook servers enabled -> no ports needed.
