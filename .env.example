# =============================================================================
# Required
# =============================================================================
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username
APPROVED_DIRECTORY=/path/to/your/projects
ALLOWED_USERS=123456789

# =============================================================================
# Multi-bot (optional) — run several isolated bots on one host. See MULTI_BOT_PLAN.md
# =============================================================================
# Short slug identifying this bot instance. Default 'main' keeps legacy paths.
# A named bot auto-derives DB (data/bot_<id>.db), inject spool
# (/tmp/codex_inject/<id>/), relay-state (/tmp/codex_relay_state_<id>.json).
# Set this ONLY in a per-bot env file (bot2.env, ...), launched via
# `./start_bot.sh <id>` / `./restart_bot.sh <id>`.
# BOT_ID=main
# Base dir for per-bot inject spool directories.
# INJECT_DIR=/tmp/codex_inject

# =============================================================================
# Codex CLI
# =============================================================================
# OpenAI key. If unset, the bot relies on existing `codex login` credentials
# in ~/.codex/auth.json. Set this to authenticate non-interactively.
# OPENAI_API_KEY=sk-...

# Path to the codex binary (auto-detected from PATH if unset).
# CODEX_CLI_PATH=/usr/local/bin/codex

# Model. Leave unset to use whatever your codex config.toml has as default.
# Examples: gpt-5-codex, gpt-5, gpt-5-mini
# CODEX_MODEL=gpt-5-codex

# Reasoning effort for gpt-5 family: minimal | low | medium | high
# CODEX_REASONING_EFFORT=medium

# Codex sandbox policy: read-only | workspace-write | danger-full-access
# Default: workspace-write when SANDBOX_ENABLED=true, else danger-full-access.
# CODEX_SANDBOX_MODE=workspace-write

# Pass --skip-git-repo-check (default true). Set to false to require a git repo.
# CODEX_SKIP_GIT_REPO_CHECK=true

# DANGER: bypass approvals & sandbox completely.
# Only enable if the host is already externally sandboxed.
# CODEX_DANGEROUSLY_BYPASS=false

# Comma-separated list of additional writable directories (--add-dir).
# CODEX_ADD_DIRS=/tmp,/var/log

# Comma-separated free-form `-c key=value` overrides applied to every run.
# CODEX_CONFIG_OVERRIDES=tools.web_search=true,model_reasoning_effort=high

# Per-run timeout (seconds) before the codex subprocess is killed.
CODEX_TIMEOUT_SECONDS=900

# Synthetic self-wake trigger file. Defaults to data/codex_inject_message.json.
# CODEX_INJECT_PATH=/home/sky/home/TRASHCAN/codex_telegram_bot/data/codex_inject_message.json

# =============================================================================
# Voice (optional, requires `pip install '.[voice]'`)
# =============================================================================
# Provider: mistral | openai | local
# VOICE_PROVIDER=mistral
# MISTRAL_API_KEY=...
# (OPENAI_API_KEY above is also used for whisper-1 if VOICE_PROVIDER=openai)

# =============================================================================
# Misc
# =============================================================================
# DEBUG=false
# LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///data/bot.db
# SESSION_TIMEOUT_HOURS=24
